# Copien este archivo como .env (o usen "set" en cmd) y pongan sus valores reales.
# NUNCA suban el .env real: ya está en .gitignore.

# Secreto para firmar los tokens JWT (una cadena larga y aleatoria)
JWT_SECRETO=

# Páginas que pueden usar la API desde el navegador (CORS), separadas por coma
CORS_ORIGENES=http://127.0.0.1:5500,http://localhost:5500

# Servicio externo: Gemini, para normalizar y clasificar la carrera (POST /api/estudiantes/carrera)
# La clave se crea en https://aistudio.google.com/apikey  (también se acepta como API_KEY)
GEMINI_API_KEY=
# Recomendado: el modelo de omisión (gemini-flash-lite-latest) puede tardar más de 5 s
GEMINI_MODELO=gemini-3.1-flash-lite

# Para las pruebas de probar_api.py: la IA pasa por el simulador de fallas
# EXTERNO_URL=http://127.0.0.1:9000

# Puerto de la API y archivo de la base de datos (opcionales)
# PORT=3000
# DB_PATH=registro.db
